# Stripe — create at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook signing secret — from the webhook endpoint you create at
# https://dashboard.stripe.com/webhooks (event: payment_intent.succeeded).
# For local testing: `stripe listen --forward-to localhost:1500/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Order notification — where the owner copy of each order confirmation lands
# on payment_intent.succeeded. These are INTERNAL inboxes (the owners), not a
# customer-facing address. Comma-separate for multiple recipients.
ORDER_NOTIFICATION_EMAIL=you@example.com,partner@example.com

# Mailgun — sends the order confirmation (owner + BCC customer).
# API key: https://app.mailgun.com/app/account/security/api_keys (Private API key)
#
# MAILGUN_FROM must stay on the mg.* subdomain — that is what is DNS-verified
# for sending. It does NOT receive mail, so it is deliberately not the address
# customers write to. Replies are steered to CONTACT_EMAIL (src/lib/site.ts)
# via a Reply-To header in src/lib/mailgun.ts.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.theslimecompany.com
MAILGUN_FROM=The Slime Co <orders@mg.theslimecompany.com>

# BetterStack Telemetry — structured application logs (src/lib/logger.ts).
# Both unset is a supported state: logging falls back to console only, which
# is what local dev and preview deploys normally want.
# Source token is per-source and write-only; find it under the source in
# https://telemetry.betterstack.com/. Vault: op://DEV/dd.betterstack.slime
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_HOST=sNNNNNNN.us-west-2a.betterstackdata.com

# DD print worker — pipes ZPL shipping labels to the Zebra 4x6 on dd-mini.
# Service lives in ~/dev/dd/infra/print-worker (owned by the dd session, not
# this repo) and is published through Jason's cloudflared tunnel.
#
# PRINT_WORKER_TOKEN is a SHARED SECRET and is deliberately NOT prefixed
# NEXT_PUBLIC_. src/lib/print.ts is server-only: an admin screen that wants to
# print calls one of our API routes, and that route calls the worker. If this
# value ever reaches the browser bundle it is burned and buys nothing.
#
# Vault: op://DEV/dd.printworker/token (Jason mints it; ask dd before changing
# the contract). Leave both unset to disable printing — callers throw a clear
# "not configured" rather than silently no-op.
PRINT_WORKER_URL=https://print.dosscodesigns.com
PRINT_WORKER_TOKEN=
