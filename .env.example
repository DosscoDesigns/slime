# Stripe — create at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook signing secret — from the webhook endpoint you create at
# https://dashboard.stripe.com/webhooks (event: payment_intent.succeeded).
# For local testing: `stripe listen --forward-to localhost:1500/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Order notification — order confirmations are emailed here on
# payment_intent.succeeded. Comma-separate for multiple recipients.
ORDER_NOTIFICATION_EMAIL=orders@theslimecompany.com

# Mailgun — sends the order confirmation (owner + BCC customer).
# API key: https://app.mailgun.com/app/account/security/api_keys (Private API key)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.theslimecompany.com
MAILGUN_FROM=The Slime Co <orders@mg.theslimecompany.com>
